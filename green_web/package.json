{
  "name": "green_demo_web",
  "version": "0.1.0",
  "private": true,
  "description": "Reference web app for querying green demo data from BigQuery.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=3001 node --watch src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node src/server.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@google-cloud/bigquery": "^8.3.1",
    "chart.js": "^4.5.0",
    "chartjs-chart-sankey": "^0.14.3",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "vite": "^8.1.3",
    "vue": "^3.5.17"
  },
  "engines": {
    "node": ">=20"
  }
}
